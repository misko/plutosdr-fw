set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR arm)
if(NOT DEFINED ENV{PLUTO_TOOLCHAIN_ROOT})
 message(FATAL_ERROR "Set PLUTO_TOOLCHAIN_ROOT to the pinned Linaro Buildroot host tree")
endif()
set(CMAKE_C_COMPILER "$ENV{PLUTO_TOOLCHAIN_ROOT}/bin/arm-linux-gnueabihf-gcc")
set(CMAKE_SYSROOT "$ENV{PLUTO_TOOLCHAIN_ROOT}/arm-buildroot-linux-gnueabihf/sysroot")
set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

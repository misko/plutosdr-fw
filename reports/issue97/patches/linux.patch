 drivers/iio/adc/ad9361.c              | 87 +++++++++++++++++++++++++++
 drivers/iio/adc/ad9361.h              |  8 ++-
 drivers/iio/adc/adi_tandem_agc.c      | 81 ++++++++++++++++++++-----
 drivers/iio/adc/cf_axi_adc.h          |  2 +
